#!/usr/bin/env bash
# Run locally after owner approval. No image archive/history is retained.
set -euo pipefail
[[ $# = 3 ]] || { echo 'Usage: transfer-staging-images SSH_TARGET CONFIG_TAR RELEASE_FILE' >&2; exit 2; }
target="$1"
[[ "$target" =~ ^[a-zA-Z0-9_.-]+@[a-zA-Z0-9_.-]+$ ]] || { echo 'Invalid SSH target' >&2; exit 2; }
bundle="$(realpath "$2")"
release="$(realpath "$3")"
python3 "$(dirname "${BASH_SOURCE[0]}")/validate_staging_release.py" "$bundle" "$release" --check-images
mapfile -t images < <(sed -n '/^[A-Z_]*_IMAGE=/s/^[^=]*=//p' "$release")
[[ ${#images[@]} = 7 ]]
docker save "${images[@]}" | gzip -1 | ssh -o BatchMode=yes -o StrictHostKeyChecking=yes "$target" \
  'flock -n /srv/fildah/staging/.rollout.lock docker load'
