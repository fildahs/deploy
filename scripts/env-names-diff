#!/usr/bin/env python3
"""Print names absent from an env file. Never emit credential values."""

import argparse
from pathlib import Path
import re


def names(path):
    result = set()
    for line in path.read_text().splitlines():
        match = re.match(r'^\s*(?:export\s+)?([A-Za-z_][A-Za-z_0-9]*)\s*=', line)
        if match:
            result.add(match[1])
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('env_file', type=Path)
    parser.add_argument('--sample', type=Path, default=Path(__file__).resolve().parents[1] / 'staging.env.sample')
    args = parser.parse_args()
    try:
        missing = names(args.sample) - names(args.env_file)
    except (OSError, UnicodeError):
        raise SystemExit('Cannot read an environment file; values were not displayed.') from None
    for name in sorted(missing):
        print(name)


if __name__ == '__main__':
    main()
