#!/usr/bin/env python3
"""Pin the existing production project."""

import os
import sys
from pathlib import Path


def command(directory, arguments):
    result = ["docker", "compose", "-p", "deploy", "-f", "compose.yml"]
    return result + arguments


if __name__ == "__main__":
    root = Path(__file__).resolve().parents[1]
    os.chdir(root)
    args = command(root, sys.argv[1:])
    os.execvp(args[0], args)
