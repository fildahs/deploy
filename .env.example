# Runtime credentials. Stable application and container defaults live in code
# and Compose; business controls live in the registered Platform settings.

# Django and data services
SECRET_KEY=change-this-to-a-long-random-secret
POSTGRES_PASSWORD=change-this-postgres-password
QDRANT_API_KEY=change-this-qdrant-api-key

# Optional object-storage credentials
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=

# AI and data providers
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Payment providers
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
OPAY_SECRET_KEY=
OPAY_PUBLIC_KEY=
OPAY_MERCHANT_ID=

# Free trial (bill-3): keys the fingerprint that marks an email's trial as used.
# A long random value; never rotate it unless it leaks (a new key re-opens
# every trial). Blank turns the trial off.
BILLING_TRIAL_KEY=

# Email and OAuth
BREVO_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CI/CD recovery credentials. Compose does not pass these into containers.
DEPLOY_REPO_DISPATCH_TOKEN=
GHCR_READ_TOKEN=
GHCR_CLEANUP_TOKEN=
